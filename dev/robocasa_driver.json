{
  "robocasa": {
    "env_name": "OpenCabinet",
    "split": "target",
    "seed": 7,
    "mujoco_gl": "egl"
  },
  "cameras": {
    "robot0_agentview_left": {
      "mode": "existing"
    },
    "robot0_agentview_right": {
      "mode": "existing"
    },
    "robot0_eye_in_hand": {
      "mode": "existing"
    },
    "perception_oblique_1": {
      "mode": "auto",
      "fovy": 62.0,
      "width": 518,
      "height": 518
    },
    "perception_oblique_2": {
      "mode": "auto",
      "fovy": 62.0,
      "width": 518,
      "height": 518
    },
    "perception_oblique_3": {
      "mode": "auto",
      "fovy": 62.0,
      "width": 518,
      "height": 518
    },
    "perception_side_1": {
      "mode": "auto",
      "fovy": 65.0,
      "width": 518,
      "height": 518
    },
    "perception_side_2": {
      "mode": "auto",
      "fovy": 65.0,
      "width": 518,
      "height": 518
    }
  },
  "observation": {
    "enabled": true,
    "reference_view": "perception_oblique_1",
    "camera_names": [
      "perception_oblique_1",
      "perception_oblique_2",
      "perception_oblique_3",
      "perception_side_1",
      "perception_side_2"
    ]
  },
  "motion": {
    "position_gain": 0.5,
    "rotation_gain": 0.5,
    "position_tolerance_m": 0.005,
    "rotation_tolerance_rad": 0.05,
    "max_steps": 100,
    "move_linear_steps": 40,
    "settle_steps": 30,
    "gripper_steps": 30,
    "publish_every_n_steps": 5
  },
  "vla": {
    "server_url": "ws://localhost:8000",
    "resize_size": 224,
    "replan_steps": 5,
    "publish_every_n_steps": 5,
    "stop_on_success": true
  },
  "evaluation": {
    "enabled": true,
    "status_path": "artifacts/evaluation/status.json"
  }
}

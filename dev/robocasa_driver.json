{
  "robocasa": {
    "env_name": "OpenCabinet",
    "split": "target",
    "seed": 7,
    "mujoco_gl": "egl"
  },
  "cameras": {
    "robot0_agentview_left": {"mode": "existing"},
    "robot0_agentview_right": {"mode": "existing"},
    "robot0_eye_in_hand": {"mode": "existing"}
  },
  "observation": {
    "enabled": true,
    "reference_view": "robot0_agentview_left"
  },
  "motion": {
    "position_gain": 0.5,
    "rotation_gain": 0.5,
    "position_tolerance_m": 0.005,
    "rotation_tolerance_rad": 0.05,
    "max_steps": 100,
    "move_linear_steps": 40,
    "settle_steps": 30,
    "gripper_steps": 30,
    "publish_every_n_steps": 5
  },
  "vla": {
    "server_url": "ws://localhost:8000",
    "resize_size": 224,
    "replan_steps": 5,
    "publish_every_n_steps": 5,
    "stop_on_success": true
  },
  "evaluation": {
    "enabled": true,
    "status_path": "artifacts/evaluation/status.json"
  }
}
